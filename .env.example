# Skoolyst Ads — local environment template (Section 11.g/h)
#
# Copy this file to `.env` (same folder) and fill in real local
# values. `.env` itself is git-ignored — never commit real
# credentials. core/Env.php loads this file automatically at the
# top of public/index.php and every database/scripts/*.php CLI
# script, so config/database.php and config/app.php's getenv()
# calls pick these up with no other setup.

# --- App ---------------------------------------------------------
APP_NAME="Skoolyst Ads — AdEngine"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Projects/Skoolyst_adds/skoolyst-advertisement/public
APP_TIMEZONE=UTC

# --- Database (MySQL, Section 5/9.h) ------------------------------
# Must match a database you created locally, e.g. via phpMyAdmin or:
#   mysql -u root -p -e "CREATE DATABASE skoolyst_ads CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skoolyst_ads
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Seeding (database/seeders/*.php) -----------------------------
# Password given to every mock/seeded user account. Change this in
# any environment that isn't your own machine.
SEED_PASSWORD=ChangeMe123!
