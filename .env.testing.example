# Skoolyst Ads — test environment template (Section 13.g)
#
# Copy this file to `.env.testing` (same folder) and fill in a
# DISPOSABLE database — one PHPUnit is free to wipe between every
# test. Never point this at the same database as your `.env` — see
# the "Running Tests" section in README.md for how to create it.
#
# tests/bootstrap.php loads this file (never `.env`) and refuses to
# run at all unless DB_NAME contains "test", as a safety net against
# accidentally truncating a real database.

# --- App -----------------------------------------------------------
APP_NAME="Skoolyst Ads — AdEngine (testing)"
APP_ENV=testing
APP_DEBUG=true
APP_TIMEZONE=UTC

# --- Database (MySQL/MariaDB) --------------------------------------
# Create this database first, e.g.:
#   mysql -u root -p -e "CREATE DATABASE skoolyst_ads_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
# then run:
#   php database\scripts\reset-test-db.php
# to create every table fresh (Section 13.g) — see README.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skoolyst_ads_test
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- HTTP integration tests (tests/Support/HttpServerTestCase.php) -
# Port PHPUnit spins up `php -S` on for the endpoint/contract tests
# (Section 13.f/13.h). Different from the 8099 used for manual local
# testing (Quick Start section) so the two never collide if both are
# running at once.
TEST_HTTP_PORT=8098
